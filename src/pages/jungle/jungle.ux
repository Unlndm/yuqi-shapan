<!--
  pages/jungle — 斗兽棋（7×9）对局页。
  职责：开局设置（人机 / 双人）+ 状态机（idle/matching/playing/thinking/over）
        + 全屏可滚动棋盘（原生 scroll 摄像机）+ 选子/落子/悔棋/重开/退出/存档。
  规则全部在 rules/jungle.js（纯函数）：八兽等级、陷阱、河流、兽穴、鼠象特例、虎狮跳河、
  50 回合无吃子判和。页面只负责渲染与驱动。
  配色：规则层用 1白/2黑 表示双方；本页按斗兽棋惯例映射为 **红方（1，下方）/ 蓝方（2，上方）**。
  地形与棋子配色为固定语义色（不随主题切换），页面骨架仍走 theme Token。
-->
<template>
  <div class="page" style="background-color:{{t.pageBg}}">

    <!-- 开局设置面板（idle）：矮画布放不下 → 放进 scroll -->

    <!-- 开始页（仅方屏）：左上返回，右侧标题；对局中不渲染，游戏界面仍用抽屉 -->
    <div class="setup-nav" if="{{rectScreen && state === 'idle'}}">
      <input type="button" class="setup-nav-back" value="＜"
             style="color:{{t.onSurface}};background-color:{{t.surfaceContainerHigh}}"
             @click="exit" />
      <text class="setup-nav-title" style="color:{{t.onSurface}}">斗兽棋</text>
    </div>

    <scroll class="panel-vp" if="{{state === 'idle'}}" scroll-y="true" bounces="true">
      <div class="setup">
        <text class="s-title" style="color:{{t.onSurface}}">斗兽棋</text>
        <text class="s-label" style="color:{{t.onSurfaceVariant}};font-size:{{fz.md}}px">对战模式</text>
        <div class="chips chips-mode">
          <div class="chip chip-mode" for="{{(mi, m) in modes}}"
               style="background-color:{{m.sel ? t.primaryContainer : t.surfaceVariant}};border-color:{{m.sel ? t.primaryContainer : t.outline}}"
               @click="pickMode(mi)">
            <text class="chip-t" style="color:{{m.sel ? t.onPrimaryContainer : t.onSurfaceVariant}}">{{m.n}}</text>
          </div>
        </div>
        <text class="s-hint" style="color:{{t.onSurfaceVariant}};font-size:{{fz.sm}}px">红方先手；鼠可入水、吃象；虎狮可跳河；进入对方兽穴即获胜。</text>
        <input type="button" class="s-start" value="继续上局" if="{{hasSave}}"
               style="color:{{t.onSurface}};background-color:{{t.surface}};border-color:{{t.primaryContainer}}"
               @click="continueGame" />
        <input type="button" class="s-start" value="开始对局"
               style="color:{{t.onPrimaryContainer}};background-color:{{t.primaryContainer}};border-color:{{t.primaryContainer}}"
               @click="startMatching" />
        <div class="s-secondary">
        <input type="button" class="s-back s-half s-intro" value="玩法介绍"
               style="color:{{t.onSurfaceVariant}};background-color:{{t.surface}};border-color:{{t.outline}}"
               @click="openHelp" />
        <input type="button" class="s-back s-half s-return" value="返 回"
               style="color:{{t.onSurfaceVariant}};background-color:{{t.surface}};border-color:{{t.outline}}"
               @click="exit" />
        </div>
      </div>
    </scroll>

    <!-- 匹配加载页（人机） -->
    <div class="matching" if="{{state === 'matching'}}">
      <text class="m-title" style="color:{{t.onSurface}}">斗兽棋</text>
      <text class="m-mode" style="color:{{t.onSurfaceVariant}}">人机对战</text>
      <div class="m-dots">
        <div class="m-dot" style="opacity:{{breathOn ? 1 : 0.2}};background-color:{{t.primary}}"></div>
        <div class="m-dot" style="opacity:{{breathOn ? 0.2 : 1}};background-color:{{t.primary}}"></div>
        <div class="m-dot" style="opacity:{{breathOn ? 1 : 0.2}};background-color:{{t.primary}}"></div>
      </div>
      <text class="m-status" style="color:{{t.onSurfaceVariant}}">{{matchPhase === 'done' ? '匹配成功' : '正在匹配对手…'}}</text>
      <text class="m-diff" if="{{matchPhase === 'done'}}" style="color:{{t.primary}}">对手强度 · {{matchLabel}}</text>
      <input type="button" class="s-back" value="取 消"
             style="color:{{t.onSurfaceVariant}};background-color:{{t.surface}};border-color:{{t.outline}}"
             @click="cancelMatch" />
    </div>

    <!-- 对局 -->
    <block if="{{state !== 'idle' && state !== 'matching'}}">
      <!-- 原生 scroll 承载棋盘（屏幕＝摄像机）；bounces=false 把摄像机钳制在舞台内 -->
      <scroll class="vp" id="vp" scroll-x="true" scroll-y="true" bounces="false">
        <div class="stage" style="width:{{stageW}}px;height:{{stageH}}px">
          <div class="board" style="margin-left:{{boardX}}px;margin-top:{{boardY}}px;width:{{boardW}}px;height:{{boardH}}px;background-color:{{boardBg}}">
            <!-- 7×9 地形格：陆地 / 河流（蓝底）/ 陷阱（红蓝「陷」）/ 兽穴（红蓝「穴」） -->
            <div class="cell" for="{{cells}}"
                 style="left:{{$item.x}}px;top:{{$item.y}}px;width:{{$item.w}}px;height:{{$item.h}}px;background-color:{{$item.bg}};border-color:{{$item.bd}}">
              <text class="cell-glyph" if="{{$item.glyph}}"
                    style="left:0px;top:0px;width:{{$item.w}}px;height:{{$item.h}}px;line-height:{{$item.h}}px;font-size:{{$item.fs}}px;color:{{$item.fg}}">{{$item.glyph}}</text>
            </div>
            <!-- 空位走子提示点 -->
            <div class="hint" for="{{hints}}"
                 style="left:{{$item.x}}px;top:{{$item.y}}px;width:{{$item.d}}px;height:{{$item.d}}px;background-color:{{t.primary}};border-color:{{t.onSurface}};opacity:0.85"></div>
            <!-- 最后一手起止格描边 -->
            <div class="marker" for="{{markers}}"
                 style="left:{{$item.x}}px;top:{{$item.y}}px;width:{{$item.s}}px;height:{{$item.s}}px;border-color:{{t.lastMark}}"></div>
            <!-- 八兽：汉字字形 + 红/蓝配色；选中时金色描边 -->
            <div class="piece" for="{{pieces}}"
                 style="left:{{$item.x}}px;top:{{$item.y}}px;width:{{$item.d}}px;height:{{$item.d}}px;background-color:{{$item.bg}};border-color:{{$item.border}};opacity:{{dimmed ? 0.7 : 1}}">
              <text class="piece-glyph" style="font-size:{{$item.fs}}px;color:{{$item.fg}}">{{$item.glyph}}</text>
            </div>
            <!-- 可吃/可跳目标框：红＝吃子、金＝跳河 -->
            <div class="target" for="{{targets}}"
                 style="left:{{$item.x}}px;top:{{$item.y}}px;width:{{$item.s}}px;height:{{$item.s}}px;border-color:{{$item.color}}"></div>
          </div>
          <div class="tap-layer" id="board" style="left:0px;top:0px;width:{{stageW}}px;height:{{stageH}}px" @click="onBoardClick"></div>
        </div>
      </scroll>

      <!-- 顶部浮层 -->
      <div class="status-pill">
        <input type="button" class="menu-fab" value="菜单"
               style="color:{{t.onSurface}};background-color:{{t.surfaceContainerHigh}};border-color:{{t.outline}}"
               @click="openMenu" />
        <div class="status-cap" style="background-color:{{t.surfaceContainerHigh}}">
          <div class="dot" style="background-color:{{turnDot}};border-color:{{turnDotRing}}"></div>
          <text class="turn-text" style="color:{{turnLabelColor}};font-size:{{fz.md}}px">{{turnLabel}}</text>
        </div>
      </div>

      <!-- 离开对局确认 -->
      <div class="modal-mask" if="{{showExitConfirm}}" style="height:{{pageH}}px" @click="cancelExit">
        <div class="modal" style="background-color:{{t.surfaceContainerHigh}};border-color:{{t.outline}}">
          <text class="modal-title" style="color:{{t.onSurface}}">离开对局？</text>
          <text class="modal-sub" style="color:{{t.onSurfaceVariant}};font-size:{{fz.md}}px">回到主页可稍后「继续上局」</text>
          <input type="button" class="m-btn" value="继续游戏"
                 style="color:{{t.onPrimaryContainer}};background-color:{{t.primaryContainer}};border-color:{{t.primaryContainer}}"
                 @click="cancelExit" />
          <input type="button" class="m-btn" value="回到主页"
                 style="color:{{t.onSurface}};background-color:{{t.surfaceContainerHigh}};border-color:{{t.outline}}"
                 @click="leaveHome(true)" />
          <input type="button" class="m-btn" value="狠心离开"
                 style="color:{{t.onSurfaceVariant}};background-color:{{t.surfaceContainerHigh}};border-color:{{t.outline}}"
                 @click="leaveHome(false)" />
        </div>
      </div>

      <!-- 重开确认 -->
      <div class="modal-mask" if="{{showRestartConfirm}}" style="height:{{pageH}}px" @click="cancelRestart">
        <div class="modal" style="background-color:{{t.surfaceContainerHigh}};border-color:{{t.outline}}">
          <text class="modal-title" style="color:{{t.onSurface}}">重开对局？</text>
          <text class="modal-sub" style="color:{{t.onSurfaceVariant}};font-size:{{fz.md}}px">当前对局已自动保存，可随时「继续上局」</text>
          <input type="button" class="m-btn" value="继续对局"
                 style="color:{{t.onPrimaryContainer}};background-color:{{t.primaryContainer}};border-color:{{t.primaryContainer}}"
                 @click="cancelRestart" />
          <input type="button" class="m-btn" value="重 开"
                 style="color:{{t.onSurfaceVariant}};background-color:{{t.surfaceContainerHigh}};border-color:{{t.outline}}"
                 @click="confirmRestart" />
        </div>
      </div>

      <!-- 结束弹窗 -->
      <div class="modal-mask" if="{{showModal}}" style="height:{{pageH}}px" @click="hideModal">
        <div class="modal" style="background-color:{{t.surfaceContainerHigh}};border-color:{{t.outline}}">
          <div class="modal-dot" style="background-color:{{turnDot}};border-color:{{turnDotRing}}"></div>
          <text class="modal-title" style="color:{{turnLabelColor}}">{{turnLabel}}</text>
          <text class="modal-sub" style="color:{{t.onSurfaceVariant}};font-size:{{fz.md}}px">{{resultReason}}</text>
          <input type="button" class="m-btn" value="再来一局"
                 style="color:{{t.onPrimaryContainer}};background-color:{{t.primaryContainer}};border-color:{{t.primaryContainer}}"
                 @click="playAgain" />
          <input type="button" class="m-btn" value="查看棋盘"
                 style="color:{{t.onSurface}};background-color:{{t.surfaceContainerHigh}};border-color:{{t.outline}}"
                 @click="hideModal" />
          <input type="button" class="m-btn" value="返回主页"
                 style="color:{{t.onSurfaceVariant}};background-color:{{t.surfaceContainerHigh}};border-color:{{t.outline}}"
                 @click="exit" />
        </div>
      </div>

      <!-- 控制抽屉 -->
      <div class="drawer-mask" if="{{showMenu}}" style="height:{{pageH}}px" @click="closeMenu">
        <div class="drawer" style="background-color:{{t.surfaceContainerHigh}}" @click="noop">
          <div class="drawer-grip" style="background-color:{{t.outline}}"></div>
          <div class="d-grid">
            <input type="button" value="悔 棋" class="d-item" disabled="{{!canUndo}}"
                   style="color:{{t.onSurface}};background-color:{{t.surfaceContainerHigh}}" @click="menuUndo" />
            <input type="button" value="重 开" class="d-item"
                   style="color:{{t.primary}};background-color:{{t.surfaceContainerHigh}}" @click="menuRestart" />
            <input type="button" value="玩法介绍" class="d-item"
                   style="color:{{t.onSurface}};background-color:{{t.surfaceContainerHigh}}" @click="menuHelp" />
            <input type="button" value="退出对局" class="d-item"
                   style="color:{{t.onSurfaceVariant}};background-color:{{t.surfaceContainerHigh}}" @click="menuExit" />
          </div>
        </div>
      </div>
    </block>
  </div>
</template>

<style>
@import './jungle.css';
</style>

<script>
/**
 * 斗兽棋页脚本。
 * 坐标/摄像机/热区口径与 game.ux、draughts 完全一致（原生 scroll + tap-layer + rect 换算）。
 * 规则层用 1=白（下）/2=黑（上）；本页展示为红方（1）/蓝方（2）。
 */
var router = require('@system.router')
var config = global.YQ.config
var themeMod = global.YQ.theme
var haptic = global.YQ.haptic
var economy = global.YQ.economy
var rng = global.YQ.rng
var BoardGeometry = global.YQ.BoardGeometry
var ai = global.YQ.ai
var jungleRule = require('../../rules/jungle.js')
var screen = global.YQ.screen

var GAME_ID = 'jungle'
var BASE_CELL = 23      // 7×23 + 2×4 = 169；9×23 + 2×4 = 215
var PAD = 4
var UNDO_MAX = 30
var TAP_DEBOUNCE = 250
var PILL_CLEAR = 26
var PILL_CLEAR_CAPSULE = 68
var THINK_BASE = { easy: 600, normal: 900, hard: 1200 }

// ── 盘面固定语义色 ────────────────────────────────────────────────
var BOARD_BG = '#4A5D3A'
var LAND_BG = '#CFE0B8'
var LAND_BD = '#B4C79A'
var WATER_BG = '#3C7FB1'
var WATER_BD = '#2C628B'
var WATER_FG = '#D8EEF9'
var TRAP_BG = '#CBB99A'
var TRAP_BD = '#A99270'
var DEN_BG = '#B9A98A'
var RED = '#C0392B'
var RED_BD = '#7C2419'
var RED_FG = '#FFF5EC'
var BLUE = '#2E5E9E'
var BLUE_BD = '#1A3A66'
var BLUE_FG = '#F0F6FF'
var SEL_RING = '#F2C230'
var CAP_RING = '#C0392B'
var JUMP_RING = '#7A5900'

var RANK_NAMES = ['', '鼠', '猫', '狗', '狼', '豹', '虎', '狮', '象']

// 输入：棋子码（1..8 红 / 9..16 蓝）；输出：1 红 / 2 蓝 / 0 空。
function pieceColor(v) {
  return v === 0 ? 0 : v <= 8 ? 1 : 2
}

// 输入：棋子码；输出：等级 1..8。
function rankOf(v) {
  return v <= 8 ? v : v - 8
}

// 输入：格坐标；输出：是否河流（与 rules/jungle.js 一致）。
function inWater(i, j) {
  return j >= 3 && j <= 5 && ((i >= 1 && i <= 2) || (i >= 4 && i <= 5))
}

// 输入：格坐标；输出：陷阱归属（0 无 / 1 红 / 2 蓝）。
function trapOwner(i, j) {
  if (j === 0 && (i === 2 || i === 4)) return 2
  if (j === 1 && i === 3) return 2
  if (j === 8 && (i === 2 || i === 4)) return 1
  if (j === 7 && i === 3) return 1
  return 0
}

// 输入：格坐标；输出：兽穴归属（0 无 / 1 红 / 2 蓝）。
function denOwner(i, j) {
  if (i !== 3) return 0
  if (j === 0) return 2
  if (j === 8) return 1
  return 0
}

export default {
  data: {
    challenge: 0,            // 路由参数：每日挑战（1 = 挑战模式；必须在 data 声明）
    date: '',                // 路由参数：挑战日期 YYYYMMDD
    seed: 0,                 // 路由参数：挑战种子
    campaignId: '',          // 路由参数：闯关关卡 id
    campaignDiff: '',        // 路由参数：闯关指定难度
    t: themeMod.current(),
    state: 'idle',
    mode: 'ai',
    modes: [],
    matchLabel: '',
    matchPhase: 'loading',
    breathOn: true,
    turnLabel: '',
    turnLabelColor: '',
    turnDot: '',
    turnDotRing: '',
    vpW: 192,
    vpH: 490,
    pageH: 490,
    rectScreen: false,
    fz: config.fontTokens('normal'),
    uiS: 1,
    pillScreen: true,
    hasSave: false,
    boardBg: BOARD_BG,
    boardW: 0,
    boardH: 0,
    boardX: 0,
    boardY: 0,
    stageW: 192,
    stageH: 490,
    cells: [],
    pieces: [],
    hints: [],
    targets: [],
    markers: [],
    canUndo: false,
    dimmed: false,
    showModal: false,
    resultReason: '',
    showExitConfirm: false,
    showRestartConfirm: false,
    showMenu: false
  },

  onInit() {
    // 首帧先铺默认模式选项，异步设置回来后再校正
    this.syncSetupUI()
    config.seedTheme(this)
    // 每日挑战：强制人机 / 普通难度 / 跳过匹配，并由种子决定执子；
    // 普通对局不创建 RNG（this.dailyRng 为 null），行为与原先一致。
    this.isChallenge = Number(this.challenge) === 1
    this.dailyRng = null
    if (this.isChallenge) {
      var seedNum = parseInt(this.seed, 10)
      if (!isFinite(seedNum)) seedNum = rng.dateSeed(this.date, GAME_ID)
      this.dailyRng = rng.create(seedNum)
    }
    this.challengePending = this.isChallenge
    this.challengeLayoutReady = false
    this.challengeCfgReady = false
    // 闯关模式：强制人机 + 关卡难度，跳过匹配
    this.isCampaign = !this.isChallenge && !!this.campaignId
    this.campaignDiffName = this.campaignDiff === 'easy' || this.campaignDiff === 'hard'
      ? this.campaignDiff : 'normal'
    if (this.isCampaign) this.challengePending = true
    this.moveCount = 0
    this.settings = config.DEFAULT_SETTINGS
    this.rules = null
    this.geo = null
    this.board = null
    this.legal = []
    this.selected = null
    this.history = []
    this.lastMove = null
    this.lastTapTime = 0
    this.lastUndoTime = 0
    this.aiTimer = null
    this.aiGen = 0
    this.matchTimer = null
    this.breathTimer = null
    this.designK = 2
    this.clientKx = 0
    this.clientKy = 0

    var that = this
    Promise.all([
      config.loadSettings(),
      config.getPref('mode', 'ai')
    ]).then(function (vals) {
      that.settings = vals[0]
      config.applyTheme(that, vals[0])
      that.syncFonts()
      haptic.applySettings(vals[0])
      that.mode = (that.isChallenge || that.isCampaign) ? 'ai' : (vals[1] === 'pvp' ? 'pvp' : 'ai')
      if (that.isCampaign) that.matchedDifficulty = that.campaignDiffName
      else if (that.isChallenge) that.matchedDifficulty = 'normal'
      that.syncSetupUI()
      that.challengeCfgReady = true
      that.beginChallengeIfReady()
    })
    this.measureScreen()
  },

  onBackPress() {
    if (this.showExitConfirm) { this.cancelExit(); return true }
    if (this.showRestartConfirm) { this.cancelRestart(); return true }
    if (this.showModal) { this.hideModal(); return true }
    if (this.showMenu) { this.closeMenu(); return true }
    if (this.state === 'playing' || this.state === 'thinking' || this.state === 'over') {
      this.openMenu()
      return true
    }
    return false
  },

  openMenu() { this.showMenu = true },
  closeMenu() { this.showMenu = false },
  noop() {},

  menuUndo() { this.closeMenu(); this.undo() },
  menuRestart() { this.closeMenu(); this.restart() },
  menuHelp() { this.closeMenu(); this.openHelp() },
  menuExit() { this.closeMenu(); this.showModal = false; this.showExitConfirm = true },

  onShow() {
    screen.keepScreenOn(true)
    var that = this
    config.getPref('save_' + GAME_ID, null).then(function (v) {
      if (v && v.board && v.board.length) that.hasSave = true
    })
    config.loadSettings().then(function (s) {
      var themeChanged = s.theme !== that.settings.theme || s.palette !== that.settings.palette
      that.settings = s
      haptic.applySettings(s)
      config.applyTheme(that, s)
      that.syncFonts()
      if (themeChanged && that.state !== 'idle' && that.board) that.renderAll()
    })
  },

  onHide() {
    screen.keepScreenOn(false)
  },

  onDestroy() {
    screen.keepScreenOn(false)
    this.aiGen++
    if (this.aiTimer) { clearTimeout(this.aiTimer); this.aiTimer = null }
    if (this.matchTimer) { clearTimeout(this.matchTimer); this.matchTimer = null }
    if (this.breathTimer) { clearInterval(this.breathTimer); this.breathTimer = null }
    this.history = null
    this.legal = null
  },

  // ── 开局设置 ────────────────────────────────────────────────────

  syncSetupUI() {
    var modes = []
    for (var i = 0; i < config.MODES.length; i++) {
      modes.push({ v: config.MODES[i].v, n: config.MODES[i].n, sel: config.MODES[i].v === this.mode })
    }
    this.modes = modes
  },

  pickMode(mi) {
    var m = this.modes[mi]
    if (!m || this.mode === m.v) return
    this.mode = m.v
    this.syncSetupUI()
  },

  // ── 匹配（人机）─────────────────────────────────────────────────

  startMatching() {
    if (this.isChallenge || this.isCampaign) {
      this.mode = 'ai'
      this.matchedDifficulty = this.isCampaign ? this.campaignDiffName : 'normal'
      this.beginGame()
      return
    }
    config.saveSetting('mode', this.mode)
    if (this.mode !== 'ai') {
      this.beginGame()
      return
    }
    if (this.aiTimer) { clearTimeout(this.aiTimer); this.aiTimer = null }
    this.state = 'matching'
    this.matchPhase = 'loading'
    this.matchLabel = ''
    var that = this
    if (this.breathTimer) clearInterval(this.breathTimer)
    this.breathTimer = setInterval(function () {
      that.breathOn = !that.breathOn
    }, 500)
    config.matchDifficulty(GAME_ID).then(function (d) {
      that.matchedDifficulty = d
    })
    var delay = 900 + Math.floor(Math.random() * 700)
    this.matchTimer = setTimeout(function () {
      that.matchPhase = 'done'
      that.matchLabel = that.matchedDifficulty === 'easy' ? '简单'
        : that.matchedDifficulty === 'hard' ? '困难' : '普通'
      haptic.place()
      that.matchTimer = setTimeout(function () {
        that.matchTimer = null
        if (that.state !== 'matching') return
        that.stopBreath()
        that.beginGame()
      }, 900)
    }, delay)
  },

  cancelMatch() {
    this.stopBreath()
    if (this.matchTimer) { clearTimeout(this.matchTimer); this.matchTimer = null }
    this.state = 'idle'
  },

  stopBreath() {
    if (this.breathTimer) { clearInterval(this.breathTimer); this.breathTimer = null }
  },

  // ── 屏幕与几何 ──────────────────────────────────────────────────

  measureScreen() {
    var that = this
    screen.getLayout().then(function (l) {
      that.pageH = l.designH
      that.rectScreen = l.profile === 'rect'
      that.designK = l.scale
      that.uiS = l.uiScale
      that.pillScreen = l.profile !== 'rect'
      config.applyFontBump(that, l)   // 手环10：内联字号 +3（随后 syncFonts 重算）
      that.syncFonts()
      that.vpW = 192
      that.vpH = Math.max(120, l.designH)
      that.syncStage()
      that.measureTouch()
      that.challengeLayoutReady = true
      that.beginChallengeIfReady()
    })
  },

  // 挑战就绪（布局 + 设置都拿到）后直接开局，跳过开局面板与匹配演出。
  beginChallengeIfReady() {
    if (!this.challengePending || !this.challengeLayoutReady || !this.challengeCfgReady) return
    this.challengePending = false
    this.beginGame()
  },

  measureTouch() {
    var that = this
    try {
      this.$element('vp').getBoundingClientRect({
        success: function (r) {
          if (r && r.width > 0 && r.height > 0) {
            var kx = that.vpW / r.width
            var ky = that.vpH / r.height
            if (kx >= 0.25 && kx <= 4) that.clientKx = kx
            if (ky >= 0.25 && ky <= 4) that.clientKy = ky
          }
        },
        fail: function () {}
      })
    } catch (e) {}
  },

  scheduleMeasure() {
    var that = this
    setTimeout(function () { that.measureTouch() }, 80)
    var delays = [100, 400, 900]
    for (var i = 0; i < delays.length; i++) {
      (function (d) {
        setTimeout(function () {
          that.measureTouch()
          that.layoutBoard()
        }, d)
      })(delays[i])
    }
  },

  syncFonts() {
    var b = config.fontTokens(this.settings ? this.settings.fontSize : 'normal', this.fontBump || 0)
    var s = this.uiS
    this.fz = { md: Math.max(9, Math.round(b.md * s)), sm: Math.max(8, Math.round(b.sm * s)) }
  },

  makeGeo() {
    var cell = Math.max(21, Math.min(60, Math.round(BASE_CELL * this.uiS)))
    return new BoardGeometry({ cols: 7, rows: 9, cell: cell, mode: 'cell', pad: PAD })
  },

  syncStage() {
    this.stageW = Math.max(this.vpW, this.boardW)
    var centered = Math.round((this.vpH - this.boardH) / 2)
    if (centered < 0) centered = 0
    this.boardX = Math.round((this.stageW - this.boardW) / 2)
    this.boardY = Math.max(centered, this.pillScreen ? PILL_CLEAR_CAPSULE : PILL_CLEAR)
    this.stageH = Math.max(this.vpH, this.boardY + this.boardH + centered)
  },

  padX() { return this.boardX },
  padY() { return this.boardY },

  // 初始摄像机：横向居中；纵向从舞台顶部开始 —— 棋盘在方屏上可能略高于画布，
  // 顶部对齐才能保证首行棋格不被顶部回合胶囊压住，超出部分由玩家下滚查看。
  layoutBoard() {
    this.scrollBoard((this.boardW - this.vpW) / 2, 0, true)
  },

  scrollBoard(left, top, instant) {
    try {
      this.$element('vp').scrollTo({
        left: Math.max(0, Math.round(left)),
        top: Math.max(0, Math.round(top)),
        behavior: instant ? 'auto' : 'smooth'
      })
    } catch (e) {}
  },

  centerOn(i, j) {
    var p = this.geo.pos(i, j)
    this.scrollBoard(this.padX() + p.x - this.vpW / 2, this.padY() + p.y - this.vpH / 2)
  },

  // ── 开局 / 恢复 / 存档 ──────────────────────────────────────────

  beginGame() {
    this.rules = jungleRule.create()
    this.geo = this.makeGeo()
    var sz = this.geo.size()
    this.boardW = sz.w
    this.boardH = sz.h
    this.syncStage()
    // 挑战/闯关模式不覆盖玩家的模式偏好，也不清普通对局存档
    if (!this.isChallenge && !this.isCampaign) {
      config.saveSetting('mode', this.mode)
      config.clearPref('save_' + GAME_ID)
      this.hasSave = false
    }
    if (this.aiTimer) { clearTimeout(this.aiTimer); this.aiTimer = null }
    this.board = this.rules.init()
    this.history = []
    this.moveCount = 0
    this.lastMove = null
    this.selected = null
    // 红方先手；挑战模式用种子决定玩家执子，同日同局执子相同
    this.humanColor = this.dailyRng ? this.dailyRng.int(2) + 1 : (Math.random() < 0.5 ? 1 : 2)
    this.aiColor = 3 - this.humanColor
    this.turn = 1 // 红方先手
    this.state = 'playing'
    this.canUndo = false
    this.dimmed = false
    this.buildCells()
    this.syncLegal()
    this.renderAll()
    this.layoutBoard()
    this.updateTurnUI()
    if (this.mode === 'ai' && this.turn === this.aiColor) this.scheduleAI()
    this.scheduleMeasure()
  },

  continueGame() {
    var that = this
    config.getPref('save_' + GAME_ID, null).then(function (snap) {
      if (!snap || !snap.board) {
        that.hasSave = false
        return
      }
      that.mode = snap.mode === 'pvp' ? 'pvp' : 'ai'
      that.matchedDifficulty = snap.difficulty || 'normal'
      that.syncSetupUI()
      that.restoreFrom(snap)
      config.clearPref('save_' + GAME_ID)
      that.hasSave = false
    })
  },

  restoreFrom(snap) {
    this.rules = jungleRule.create()
    this.geo = this.makeGeo()
    var sz = this.geo.size()
    this.boardW = sz.w
    this.boardH = sz.h
    this.syncStage()
    if (this.aiTimer) { clearTimeout(this.aiTimer); this.aiTimer = null }
    this.board = snap.board
    this.turn = snap.turn === 2 ? 2 : 1
    this.lastMove = snap.lastMove || null
    this.humanColor = snap.humanColor === 2 ? 2 : 1
    this.aiColor = 3 - this.humanColor
    this.history = []
    this.selected = null
    this.state = 'playing'
    this.canUndo = false
    this.dimmed = false
    this.buildCells()
    this.syncLegal()
    this.renderAll()
    this.layoutBoard()
    this.updateTurnUI()
    if (this.mode === 'ai' && this.turn === this.aiColor) this.scheduleAI()
    this.scheduleMeasure()
  },

  saveSnapshot() {
    // 挑战局的快照不写入普通存档（不影响普通模式的「继续上局」）
    if (this.isChallenge) return
    config.saveSetting('save_' + GAME_ID, {
      board: this.board,
      turn: this.turn,
      lastMove: this.lastMove,
      humanColor: this.humanColor,
      mode: this.mode,
      difficulty: this.matchedDifficulty || 'normal'
    })
  },

  // ── 渲染 ────────────────────────────────────────────────────────

  buildCells() {
    var cell = this.geo.cell
    var pad = this.geo.pad
    var fs = Math.max(9, Math.round(cell * 0.42))
    var arr = []
    for (var j = 0; j < 9; j++) {
      for (var i = 0; i < 7; i++) {
        var den = denOwner(i, j)
        var trap = trapOwner(i, j)
        var bg, bd, glyph, fg
        if (den) {
          bg = DEN_BG
          bd = den === 1 ? RED : BLUE
          glyph = '穴'
          fg = den === 1 ? RED : BLUE
        } else if (trap) {
          bg = TRAP_BG
          bd = TRAP_BD
          glyph = '陷'
          fg = trap === 1 ? RED : BLUE
        } else if (inWater(i, j)) {
          bg = WATER_BG
          bd = WATER_BD
          glyph = '水'
          fg = WATER_FG
        } else {
          bg = LAND_BG
          bd = LAND_BD
          glyph = ''
          fg = LAND_BD
        }
        arr.push({
          x: pad + i * cell,
          y: pad + j * cell,
          w: cell,
          h: cell,
          bg: bg,
          bd: bd,
          glyph: glyph,
          fg: fg,
          fs: fs
        })
      }
    }
    this.cells = arr
  },

  buildPieces() {
    var out = []
    if (!this.board) { this.pieces = out; return }
    var d = this.geo.cell - 4
    var fs = Math.max(11, Math.round(d * 0.52))
    var sel = this.selected
    for (var j = 0; j < 9; j++) {
      for (var i = 0; i < 7; i++) {
        var v = this.board[j][i]
        if (!v) continue
        var c = this.geo.pos(i, j)
        var red = pieceColor(v) === 1
        var border = sel && sel.i === i && sel.j === j ? SEL_RING : (red ? RED_BD : BLUE_BD)
        out.push({
          x: Math.round(c.x - d / 2),
          y: Math.round(c.y - d / 2),
          d: d,
          bg: red ? RED : BLUE,
          border: border,
          fg: red ? RED_FG : BLUE_FG,
          glyph: RANK_NAMES[rankOf(v)],
          fs: fs
        })
      }
    }
    this.pieces = out
  },

  // 选中棋子的合法目标：空位 → 圆点；吃子 → 红框；跳河 → 金框。
  buildHints() {
    var hints = []
    var targets = []
    if (this.selected && this.state === 'playing' && this.geo) {
      if (!(this.mode === 'ai' && this.turn !== this.humanColor)) {
        var cell = this.geo.cell
        var seen = {}
        for (var k = 0; k < this.legal.length; k++) {
          var m = this.legal[k]
          if (m.fi !== this.selected.i || m.fj !== this.selected.j) continue
          var key = m.i + ',' + m.j
          if (seen[key]) continue
          seen[key] = 1
          var c = this.geo.pos(m.i, m.j)
          var victim = this.board[m.j] ? this.board[m.j][m.i] : 0
          if (victim !== 0 || m.jump) {
            var s = cell - 2
            targets.push({
              x: Math.round(c.x - s / 2),
              y: Math.round(c.y - s / 2),
              s: s,
              color: victim !== 0 ? CAP_RING : JUMP_RING
            })
          } else {
            var dd = Math.max(7, Math.round(cell * 0.3))
            hints.push({ x: Math.round(c.x - dd / 2), y: Math.round(c.y - dd / 2), d: dd })
          }
        }
      }
    }
    this.hints = hints
    this.targets = targets
  },

  buildMarkers() {
    var out = []
    if (this.lastMove && this.lastMove.fi !== undefined && this.geo) {
      var s = this.geo.cell - 4
      var list = [[this.lastMove.fi, this.lastMove.fj], [this.lastMove.i, this.lastMove.j]]
      for (var k = 0; k < list.length; k++) {
        var c = this.geo.pos(list[k][0], list[k][1])
        out.push({ x: Math.round(c.x - s / 2), y: Math.round(c.y - s / 2), s: s })
      }
    }
    this.markers = out
  },

  renderAll() {
    this.buildPieces()
    this.buildHints()
    this.buildMarkers()
  },

  syncLegal() {
    this.legal = this.board ? this.rules.moves(this.board, this.turn) : []
  },

  updateTurnUI() {
    this.dimmed = this.state === 'thinking'
    this.buildHints()
    if (this.state !== 'playing' && this.state !== 'thinking') return
    var side = this.turn === 1 ? '红方' : '蓝方'
    if (this.state === 'thinking') {
      this.turnLabel = 'AI 思考中'
      this.turnLabelColor = this.t.onSurfaceVariant
    } else if (this.mode === 'pvp') {
      this.turnLabel = side + '行棋'
      this.turnLabelColor = this.t.onSurface
    } else if (this.turn === this.humanColor) {
      this.turnLabel = '你 · ' + side
      this.turnLabelColor = this.t.primary
    } else {
      this.turnLabel = side + ' · AI'
      this.turnLabelColor = this.t.onSurfaceVariant
    }
    this.turnDot = this.turn === 1 ? RED : BLUE
    this.turnDotRing = this.t.outline
  },

  // ── 交互 ────────────────────────────────────────────────────────

  onBoardClick(e) {
    if (this.state !== 'playing') return
    if (this.mode === 'ai' && this.turn !== this.humanColor) return
    var now = Date.now()
    if (now - this.lastTapTime < TAP_DEBOUNCE) return
    var ox = e ? e.offsetX : undefined
    var oy = e ? e.offsetY : undefined
    if (typeof ox === 'number' && typeof oy === 'number') {
      this.lastTapTime = now
      this.handleTap(ox * this.kx(), oy * this.ky())
      return
    }
    var that = this
    var cx = e ? e.clientX : 0
    var cy = e ? e.clientY : 0
    try {
      this.$element('board').getBoundingClientRect({
        success: function (r) {
          if (!r || r.width <= 0) return
          var n2 = Date.now()
          if (n2 - that.lastTapTime < TAP_DEBOUNCE) return
          that.lastTapTime = n2
          that.handleTap((cx - (r.left || 0)) * that.kx(), (cy - (r.top || 0)) * that.ky())
        },
        fail: function () {}
      })
    } catch (err) {}
  },

  kx() { return this.clientKx > 0 ? this.clientKx : this.designK },
  ky() { return this.clientKy > 0 ? this.clientKy : this.designK },

  handleTap(px, py) {
    if (this.state !== 'playing' || !this.geo) return
    var cell = this.geo.hit(px - this.boardX, py - this.boardY)
    if (!cell) return
    this.tapCell(cell)
  },

  tapCell(cell) {
    var mv = this.findMove(cell)
    if (mv) {
      this.doMove(mv)
      return
    }
    var v = this.board[cell.j] ? this.board[cell.j][cell.i] : 0
    if (v !== 0 && pieceColor(v) === this.turn && this.hasOrigin(cell)) {
      if (this.selected && this.selected.i === cell.i && this.selected.j === cell.j) {
        this.selected = null
      } else {
        this.selected = { i: cell.i, j: cell.j }
      }
      this.buildPieces()
      this.buildHints()
      return
    }
    haptic.invalid()
  },

  findMove(cell) {
    if (!this.selected) return null
    var hits = []
    for (var k = 0; k < this.legal.length; k++) {
      var m = this.legal[k]
      if (m.fi === this.selected.i && m.fj === this.selected.j &&
          m.i === cell.i && m.j === cell.j) hits.push(m)
    }
    if (!hits.length) return null
    if (hits.length > 1) {
      hits.sort(function (a, b) {
        var ja = a.jump ? 1 : 0
        var jb = b.jump ? 1 : 0
        return jb - ja
      })
    }
    return hits[0]
  },

  hasOrigin(cell) {
    for (var k = 0; k < this.legal.length; k++) {
      if (this.legal[k].fi === cell.i && this.legal[k].fj === cell.j) return true
    }
    return false
  },

  // ── 对局流程 ────────────────────────────────────────────────────

  doMove(move) {
    if (!move || this.state !== 'playing') return
    this.pushHistory()
    var mover = this.turn
    var victim = this.board[move.j] ? this.board[move.j][move.i] : 0
    var captured = victim !== 0 ? 1 : 0
    this.board = this.rules.apply(this.board, move, mover)
    this.lastMove = move
    this.selected = null
    this.moveCount++
    var ck = this.rules.check(this.board, move)
    this.turn = 3 - mover
    this.syncLegal()
    this.renderAll()
    if (captured > 0) haptic.capture()
    else haptic.place()
    this.centerOn(move.i, move.j)
    if (ck && ck.result) {
      this.endGame(ck)
      return
    }
    this.updateTurnUI()
    this.saveSnapshot()
    if (this.mode === 'ai' && this.turn === this.aiColor && this.state === 'playing') {
      this.scheduleAI()
    }
  },

  scheduleAI() {
    var that = this
    this.state = 'thinking'
    this.selected = null
    this.buildPieces()
    this.updateTurnUI()
    if (this.aiTimer) clearTimeout(this.aiTimer)
    if (this.aiFallbackTimer) { clearTimeout(this.aiFallbackTimer); this.aiFallbackTimer = null }
    var gen = ++this.aiGen
    var delay = (THINK_BASE[this.matchedDifficulty] || 900) + Math.floor(Math.random() * 400)
    this.aiTimer = setTimeout(function () {
      that.aiTimer = null
      if (that.state !== 'thinking' || that.aiGen !== gen) return
      ai.chooseMoveAsync(that.rules, that.board, that.turn, that.matchedDifficulty || 'normal',
        function (mv) {
          if (that.aiFallbackTimer) { clearTimeout(that.aiFallbackTimer); that.aiFallbackTimer = null }
          if (that.aiGen !== gen || that.state !== 'thinking') return
          that.state = 'playing'
          if (mv) that.doMove(mv)
          else that.updateTurnUI()
        },
        function () { return that.aiGen !== gen || that.state !== 'thinking' })
      that.aiFallbackTimer = setTimeout(function () {
        that.aiFallbackTimer = null
        if (that.state !== 'thinking' || that.aiGen !== gen) return
        var ms = that.rules && that.rules.moves ? that.rules.moves(that.board, that.turn) : null
        that.state = 'playing'
        if (ms && ms.length) that.doMove(ms[0])
        else that.updateTurnUI()
      }, 4000)
    }, delay)
  },

  endGame(ck) {
    this.selected = null
    this.hints = []
    this.targets = []
    this.state = 'over'
    this.dimmed = false
    this.canUndo = this.history.length > 0
    var res
    if (ck.result === 'draw') {
      res = 'draw'
      this.turnLabel = '和棋'
      this.turnLabelColor = this.t.resultDraw
    } else if (this.mode === 'pvp') {
      res = ck.winner === this.humanColor ? 'win' : 'lose'
      this.turnLabel = ck.winner === 1 ? '红方胜' : '蓝方胜'
      this.turnLabelColor = this.t.resultWin
    } else if (ck.winner === this.humanColor) {
      res = 'win'
      this.turnLabel = '你赢了'
      this.turnLabelColor = this.t.resultWin
    } else {
      res = 'lose'
      this.turnLabel = 'AI 获胜'
      this.turnLabelColor = this.t.resultLose
    }
    this.turnDot = this.t.outline
    this.resultReason = (ck.reason ? ck.reason + ' · ' : '') +
      (this.mode === 'ai' ? '人机' : '双人') +
      ' · 棋币 +' + economy.coinFor(res, this.mode)
    if (res === 'win') haptic.celebrate()
    else haptic.result()
    // 挑战/闯关模式不覆盖普通对局存档（普通进度保留）
    if (!this.isChallenge && !this.isCampaign) {
      config.clearPref('save_' + GAME_ID)
      this.hasSave = false
    }
    var that = this
    if (this.isCampaign) {
      // 按需加载：普通对局不把闯关关卡数据读进内存
      var campaign = global.YQ.campaignReport
      campaign.report(this.campaignId, { win: res === 'win', moves: this.moveCount }).then(function (info) {
        if (info && info.text) that.resultReason = that.resultReason + ' · ' + info.text
      })
    }
    config.recordResult(GAME_ID, res, this.mode)
    this.showModal = true
    // 每日挑战：仅挑战模式且获胜时上报；economy 侧按天去重，重复完成不重复发币
    if (this.isChallenge && res === 'win') economy.completeDaily(GAME_ID)
  },

  playAgain() {
    this.showModal = false
    if (this.isChallenge) {
      this.mode = 'ai'
      this.matchedDifficulty = 'normal'
      this.beginGame()
      return
    }
    this.startMatching()
  },

  hideModal() {
    this.showModal = false
  },

  // ── 悔棋 ────────────────────────────────────────────────────────

  pushHistory() {
    var snap = this.board.map(function (row) { return row.slice() })
    this.history.push({ board: snap, turn: this.turn, lastMove: this.lastMove })
    while (this.history.length > UNDO_MAX) this.history.shift()
    this.canUndo = true
  },

  popHistory() {
    var h = this.history.pop()
    if (!h) return
    this.board = h.board
    this.turn = h.turn
    this.lastMove = h.lastMove
    this.canUndo = this.history.length > 0
  },

  undo() {
    if (!this.history || !this.history.length) return
    var now = Date.now()
    if (now - this.lastUndoTime < 300) return
    this.lastUndoTime = now
    if (this.aiTimer) { clearTimeout(this.aiTimer); this.aiTimer = null }
    this.aiGen++
    this.popHistory()
    if (this.mode === 'ai' && this.turn !== this.humanColor && this.history.length) {
      this.popHistory()
    }
    this.selected = null
    this.state = 'playing'
    this.dimmed = false
    this.showModal = false
    this.syncLegal()
    this.renderAll()
    this.updateTurnUI()
    if (this.mode === 'ai' && this.turn === this.aiColor) this.scheduleAI()
  },

  // ── 按钮 ────────────────────────────────────────────────────────

  restart() {
    if (this.state === 'playing' || this.state === 'thinking') {
      this.showRestartConfirm = true
      return
    }
    this.doRestart()
  },

  cancelRestart() {
    this.showRestartConfirm = false
  },

  doRestart() {
    if (this.aiTimer) { clearTimeout(this.aiTimer); this.aiTimer = null }
    this.aiGen++
    this.selected = null
    this.hints = []
    this.targets = []
    this.state = 'idle'
    this.dimmed = false
    this.showModal = false
  },

  confirmRestart() {
    this.showRestartConfirm = false
    this.doRestart()
  },

  openHelp() {
    router.push({ uri: 'pages/help' })
  },

  exit() {
    if (this.state === 'playing' || this.state === 'thinking') {
      this.showExitConfirm = true
      return
    }
    router.back()
  },

  cancelExit() {
    this.showExitConfirm = false
    if (this.state === 'over') this.showModal = true
  },

  leaveHome(save) {
    this.showExitConfirm = false
    if (save && (this.state === 'playing' || this.state === 'thinking')) {
      this.saveSnapshot()
    } else {
      config.clearPref('save_' + GAME_ID)
      this.hasSave = false
    }
    router.back()
  }
}
</script>
